@{
    ViewData["Title"] = "Ordenes de Trabajo";
}
<div class="row">
    <div class="col-md-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item active" aria-current="page">Ordenes de Trabajo</li>
            </ol>
        </nav>
    </div>
</div>
<div class="row mt-3 mb-2">
    <div class="col-12 col-md-4">
        <div class="row g-3 align-items-center">
            <div class="col-auto">
                <label for="orderWorkInputSearch" class="col-form-label">Buscar Orden</label>
            </div>
            <div class="col-auto">
                <input type="text" id="orderWorkInputSearch" class="form-control">
            </div>
        </div>
    </div>
    <div class="col-12 col-md-8 mt-2 mt-md-0">
        <button type="button" class="btn btn-primary float-md-end w-25" id="btnNewOrderWork">
            <i class="bi bi-plus-circle me-2"></i>Crear Orden de Trabajo
        </button>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <hr />
    </div>
</div>

<div id="orderWorkGridContainer">
    <div class="row">
        <div class="col-md-12">
            <div class="alert alert-ligth text-center" role="alert">
                No se encontraron ordenes de trabajo.
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("Modal/OrderWork/_NewOrderWork")
@await Html.PartialAsync("Modal/OrderWork/_OrderWorkDetail")
@await Html.PartialAsync("Templates/_CrystalOrderWork")

<script src="~/js/OrderWork/OrderWork.js" type="module"></script>
