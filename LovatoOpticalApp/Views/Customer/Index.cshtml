@using LovatoOpticalApp.Application.DTOs
@{
    ViewData["Title"] = "Clientes";
    var customers = ViewData["Customers"] as PagedResult<CustomerResponseDto> ?? new PagedResult<CustomerResponseDto>();
}
<div class="row">
    <div class="col-md-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item active" aria-current="page">Clientes</li>
            </ol>
        </nav>
    </div>
</div>
<div class="row mt-3 mb-2">
    <div class="col-md-6">

        <div class="row g-3 align-items-center">
            <div class="col-auto">
                <label for="inputPassword6" class="col-form-label">Buscar Cliente</label>
            </div>
            <div class="col-auto">
                <input type="password" id="inputPassword6" class="form-control" aria-describedby="passwordHelpInline">
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <button type="button" class="btn btn-primary float-end " id="btnNewCustomer">
            <i class="bi bi-plus-circle me-2"></i>Nuevo Cliente
        </button>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <hr />
    </div>
</div>

<div class="row mt-3 mb-2">
    <h6>Cantidad de Clientes <span class="badge text-bg-primary">@customers?.Items.Count</span></h6>
</div>

@if (customers?.Items.Count == 0)
{
    <div class="row">
        <div class="col-md-12">
            <div class="alert alert-ligth text-center" role="alert">
                No se encontraron clientes.
            </div>
        </div>
    </div>
}
else
{
    @await Html.PartialAsync("Grid/_CustomerGrid")
}

@await Html.PartialAsync("Modal/Customer/_NewCustomer")
@await Html.PartialAsync("Modal/Customer/_CustomerDetail")
@await Html.PartialAsync("Modal/Recipe/_NewRecipe")

<script src="~/js/Customer/Customer.js" type="module"></script>