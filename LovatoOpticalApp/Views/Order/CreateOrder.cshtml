﻿@{
    ViewData["Title"] = "Pedido";
}


<main class="container py-4">

    <!-- HEADER -->
    <div class="row justify-content-center mb-4">
        <div class="col-lg-9">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                <div>
                    <h1 class="h4 mb-1">Crear Nuevo Pedido</h1>
                    <p class="text-muted mb-0">
                        Completa los datos del cliente, receta, armazón, cristal y pago del anticipo.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- STEPPER -->
    <div class="row justify-content-center mb-4">
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between text-center overflow-auto gap-1" id="stepper">
                        <div class="step-item" data-step="1">
                            <span class="badge rounded-circle text-bg-primary step-badge mb-2">1</span>
                            <div class="small fw-semibold">Cliente</div>
                        </div>

                        <div class="step-item" data-step="2">
                            <span class="badge rounded-circle text-bg-secondary step-badge mb-2">2</span>
                            <div class="small fw-semibold text-muted">Receta</div>
                        </div>

                        <div class="step-item" data-step="3">
                            <span class="badge rounded-circle text-bg-secondary step-badge mb-2">3</span>
                            <div class="small fw-semibold text-muted">Armazón</div>
                        </div>

                        <div class="step-item" data-step="4">
                            <span class="badge rounded-circle text-bg-secondary step-badge mb-2">4</span>
                            <div class="small fw-semibold text-muted">Cristal</div>
                        </div>

						<div class="step-item" data-step="5">
                            <span class="badge rounded-circle text-bg-secondary step-badge mb-2">5</span>
                            <div class="small fw-semibold text-muted">Accesorios</div>
                        </div>

						<div class="step-item" data-step="6">
                            <span class="badge rounded-circle text-bg-secondary step-badge mb-2">6</span>
                            <div class="small fw-semibold text-muted">Orden  de trabajo</div>
                        </div>

                        <div class="step-item" data-step="7">
                            <span class="badge rounded-circle text-bg-secondary step-badge mb-2">7</span>
                            <div class="small fw-semibold text-muted">Confirmar</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- FEEDBACK GLOBAL -->
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="alert alert-warning d-none" id="feedbackGlobal" role="alert"></div>
        </div>
    </div>

    <!-- STEP 1 -->
    @await Html.PartialAsync("Order/_CustomerSection")

    <!-- STEP 2 -->
    @await Html.PartialAsync("Order/_RecipeSection")

    <!-- STEP 3 -->
    @await Html.PartialAsync("Order/_FrameSection")

    <!-- STEP 4 -->
    @await Html.PartialAsync("Order/_CrystalSection")

	 <!-- STEP 5 -->
    @await Html.PartialAsync("Order/_AccessorySection")

	<!-- STEP 6 -->
    @await Html.PartialAsync("Order/_WorkOrderSection")

    <!-- STEP 7 -->
    @await Html.PartialAsync("Order/_ConfirmSection")
    

    <!-- NAV ACTIONS -->
    <div class="row justify-content-center mt-4">
        <div class="col-lg-9">
            <div class="d-flex justify-content-between">
                <button class="btn btn-outline-secondary" id="btnAtras" onclick="goToStep(-1)" disabled>
                    <i class="bi bi-arrow-left me-1"></i>
                    Atrás
                </button>

                <button class="btn btn-primary" id="btnSiguiente" onclick="goToStep(1)">
                    Siguiente
                    <i class="bi bi-arrow-right ms-1"></i>
                </button>
            </div>
        </div>
    </div>

</main>
<div class="modal fade" id="ticketModal" tabindex="-1" aria-labelledby="ticketModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title" id="ticketModalLabel">Orden creada</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body bg-light">
                <div class="ticket shadow-sm" id="ticketBody"></div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button class="btn btn-primary" onclick="location.reload()">Nueva orden</button>
            </div>
        </div>
    </div>
</div>

<script type="module" src="~/js/Order/Order.js"></script>