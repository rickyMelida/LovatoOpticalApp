<section class="row justify-content-center panel active" id="panel-1">
	<div class="col-lg-9">
		<div class="card shadow-sm border-0">
			<div class="card-header bg-white">
				<h2 class="h5 mb-1">Buscar cliente</h2>
				<p class="text-muted small mb-0">
					Ingresa el documento del paciente para verificar si ya existe en el sistema.
				</p>
			</div>

			<div class="card-body">
				<div class="row g-2">
					<div class="col-md-8">
						<label class="form-label">Documento</label>
						<input type="text" class="form-control" id="docInput" placeholder="Ej. 12345678">
					</div>

					<div class="col-md-4 d-grid align-items-end">
						<button class="btn btn-outline-primary mt-md-4" id="btn-search" onclick="searchPatient()">
							<i class="bi bi-search me-1"></i>
							Buscar
						</button>
					</div>
				</div>

				<div class="alert alert-success mt-3 d-none" id="pacienteEncontrado">
					<div class="d-flex justify-content-between align-items-start gap-3">
						<div>
							<strong id="pacNombre"></strong><br>
							<span class="small">Documento: <span id="pacDoc"></span></span>
						</div>
						<span class="badge text-bg-success">Cliente existente</span>
					</div>
				</div>

				<div class="alert alert-danger mt-3 d-none" id="pacienteNoEncontrado">
					<strong>No se encontró ningún cliente con ese documento.</strong>
					<div class="small">Completa los datos para registrarlo.</div>
				</div>

				<div id="formNuevoPaciente" class="mt-3 d-none">
					<hr>

					<h3 class="h6 mb-3">Registrar nuevo cliente</h3>

					<div class="row g-3">
						<form id="newCustomerForm">
							@await Html.PartialAsync("Forms/_NewCustomer")
						</form>
					</div>

					<button class="btn btn-primary mt-3 float-start" id="btnCreateCustomer" onclick="createPatient()">
						<i class="bi bi-person-plus me-1"></i>
						Crear cliente
					</button>
				</div>
			</div>
		</div>
	</div>
</section>