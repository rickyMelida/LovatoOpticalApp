<section class="row justify-content-center panel" id="panel-4">
	<div class="col-lg-9">
		<form id="crystalForm">

			<div class="row g-3">
				<div class="col-md-12">
					<h6 class="text-muted text-uppercase small mb-3">Cristal Ojo Derecho (OD)</h6>
					<div class="row">
						<div class="col-md-12">
							<label for="description-OD" class="form-label">
								Descripción
							</label>
							<textarea class="form-control" id="description-OD" name="DescriptionOD" rows="3"
									  placeholder="Descripción del cristal"></textarea>
						</div>

						<div class="col-md-6">
							<label for="crystalPurchasePriceOD" class="form-label">
								Precio Compra<span class="text-danger">*</span>
							</label>
							<div class="input-group">
								<input type="text" class="form-control input-guarani" id="crystalPurchasePriceOD"
									   name="PurchasePriceOD" placeholder="10.000" required>
							</div>
						</div>

						<div class="col-md-6">
							<label for="crystalSalePriceOD" class="form-label">
								Precio Venta<span class="text-danger">*</span>
							</label>
							<div class="input-group">
								<input type="text" class="form-control input-guarani" id="crystalSalePriceOD"
									   name="SalePriceOD" placeholder="10.000" required>
							</div>
						</div>
					</div>
				</div>
			</div>

			<div class="row g-3 mt-3">
				<div class="col-md-12">
					<h6 class="text-muted text-uppercase small mb-3">Cristal Ojo Izquierdo (OI)</h6>
					<div class="row">
						<div class="col-md-12">
							<label for="description-OI" class="form-label">
								Descripción
							</label>
							<textarea class="form-control" id="description-OI" name="DescriptionOI" rows="3"
									  placeholder="Descripción del cristal"></textarea>
						</div>

						<div class="col-md-6">
							<label for="crystalPurchasePriceOI" class="form-label">
								Precio Compra<span class="text-danger">*</span>
							</label>
							<div class="input-group">
								<input type="text" class="form-control input-guarani" id="crystalPurchasePriceOI"
									   name="PurchasePriceOI" placeholder="10.000" required>
							</div>
						</div>

						<div class="col-md-6">
							<label for="crystalSalePriceOI" class="form-label">
								Precio Venta<span class="text-danger">*</span>
							</label>
							<div class="input-group">
								<input type="text" class="form-control input-guarani" id="crystalSalePriceOI"
									   name="SalePriceOI" placeholder="10.000" required>
							</div>
						</div>

					</div>
				</div>
			</div>
		</form>
	</div>
</section>