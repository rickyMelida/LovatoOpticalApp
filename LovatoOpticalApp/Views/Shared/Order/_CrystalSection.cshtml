<style>
	.opacity-50 {
		opacity: 0.5;
		pointer-events: none;
	}
	.checkbox-group {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	.section-title {
		font-size: 1.3rem;
		font-weight: 600;
		color: var(--primary-color);
		margin-top: 1rem;
		border-bottom: 3px solid var(--secondary-color);
	}

	.section-title:first-child {
		margin-top: 0;
	}

	.checkbox-group {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	.checkbox-item {
		display: flex;
		align-items: center;
		padding: 0.8rem;
		background: #f8f9fa;
		border-radius: 8px;
		transition: all 0.3s ease;
	}

	.checkbox-item:hover {
		background: #e9ecef;
	}

	.checkbox-item input[type="checkbox"] {
		width: 20px;
		height: 20px;
		margin-right: 0.8rem;
		cursor: pointer;
	}

	.checkbox-item label {
		margin: 0;
		cursor: pointer;
		font-weight: 500;
	}
</style>
<section class="row justify-content-center panel" id="panel-3">
	<div class="col-lg-9">
		<div class="card shadow-sm border-0">
			<div class="card-header bg-white">
				<h2 class="h5 mb-1">Receta Óptica</h2>
				<p class="text-muted small mb-0">
					Usa una receta vigente o registra una nueva para esta orden.
				</p>
			</div>

			<div class="card-body">
				<div class="alert mt-3 alert-primary" id="crystalRecipe">
				</div>

				<div class="row mb-3">
					<div class="col-md-12">
						<label for="amountEyes" class="form-label">¿Cuántos Ojos? *</label>
						<select class="form-select" id="amountEyes" >
							<option value="">Seleccionar cantidad</option>
							<option value="od">Solo Ojo Derecho (OD)</option>
							<option value="oi">Solo Ojo Izquierdo (OI)</option>
							<option value="ambos">Ambos Ojos</option>
						</select>
					</div>
				</div>

				<form id="crystalForm">
						<!-- CRISTAL OJO DERECHO (OD) -->
						<div class="row g-3" id="crystal-od-section">
							<div class="col-md-12 mt-5">
								<h6 class="text-muted text-uppercase small mb-3">Cristal Ojo Derecho (OD)</h6>
								<div class="row">
									<div class="col-md-6">
										<label for="name-OD" class="form-label">
											Nombre del cristal
										</label>
										<select class="form-select" id="tipoCristalOD" onchange="cambiarTipoCristal('od')">
											<option value="">Seleccionar tipo</option>
											<option value="blanco">Blanco (Sin Graduación)</option>
											<option value="simple">Visión Simple</option>
											<option value="bifocal">Bifocal</option>
											<option value="visión">Visión Lejana</option>
											<option value="multifocal">Multifocal</option>
										</select>
									</div>

									<div class="col-md-6">
										<label for="description-OD" class="form-label">
											Descripción
										</label>
										<input type="text" class="form-control" id="description-OD" name="DescriptionOD"
											   placeholder="Descripción del cristal" />
									</div>

									<div class="section-title"><i class="fas fa-layer-group"></i> Recubrimiento</div>

									<div class="checkbox-group">
										<div class="checkbox-item">
											<input type="checkbox" id="recubOD_blanco">
											<label for="recubOD_blanco">Blanco</label>
										</div>
										<div class="checkbox-item">
											<input type="checkbox" id="recubOD_antirreflex">
											<label for="recubOD_antirreflex">Antirreflex</label>
										</div>
										<div class="checkbox-item">
											<input type="checkbox" id="recubOD_fotocromatic">
											<label for="recubOD_fotocromatic">Fotocrómático</label>
										</div>
										<div class="checkbox-item">
											<input type="checkbox" id="recubOD_filtro">
											<label for="recubOD_filtro">Filtro Luz Azul</label>
										</div>
									</div>
								</div>
							</div>
						</div>
						<hr>
						<!-- CRISTAL OJO IZQUIERDO (OI) -->
						<div class="row g-3 mt-5" id="crystal-oi-section">
							<div class="col-md-12">
								<h6 class="text-muted text-uppercase small mb-3">Cristal Ojo Izquierdo (OI)</h6>
								<div class="row">
									<div class="col-md-6">
										<label for="name-OI" class="form-label">
											Nombre del cristal
										</label>
										<select class="form-select" id="tipoCristalOI" >
											<option value="">Seleccionar tipo</option>
											<option value="blanco">Blanco (Sin Graduación)</option>
											<option value="simple">Visión Simple</option>
											<option value="bifocal">Bifocal</option>
											<option value="visión">Visión Lejana</option>
											<option value="multifocal">Multifocal</option>
										</select>
									</div>

									<div class="col-md-6">
										<label for="description-OI" class="form-label">
											Descripción
										</label>
										<input type="text" class="form-control" id="description-OI" name="DescriptionOI"
											   placeholder="Descripción del cristal" />
									</div>

									<div class="section-title"><i class="fas fa-layer-group"></i> Recubrimiento</div>

									<div class="checkbox-group">
										<div class="checkbox-item">
											<input type="checkbox" id="recubOI_blanco">
											<label for="recubOI_blanco">Blanco</label>
										</div>
										<div class="checkbox-item">
											<input type="checkbox" id="recubOI_antirreflex">
											<label for="recubOI_antirreflex">Antirreflex</label>
										</div>
										<div class="checkbox-item">
											<input type="checkbox" id="recubOI_fotocromatic">
											<label for="recubOI_fotocromatic">Fotocrómático</label>
										</div>
										<div class="checkbox-item">
											<input type="checkbox" id="recubOI_filtro">
											<label for="recubOI_filtro">Filtro Luz Azul</label>
										</div>
									</div>
								</div>
							</div>
						</div>
					</form>
	
				</div>
			</div>
		</div>
	</section>
	<script type="module" src="~/js/Order/Order.Crystal.js"></script>