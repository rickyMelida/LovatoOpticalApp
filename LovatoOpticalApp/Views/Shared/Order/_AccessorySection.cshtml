<section class="row justify-content-center panel" id="panel-5">
	<div class="col-lg-9">
		<h5 class="mb-4">Accesorios Ópticos</h5>

		<!-- Selector de accesorios con búsqueda -->
		<div class="row g-3 mb-4">
			<div class="col-md-8">
				<label for="accessorySearch" class="form-label">
					Buscar Accesorio
				</label>
				<div class="position-relative">
					<input type="text" class="form-control" id="accessorySearch"
						   placeholder="Escribe para buscar accesorios..." autocomplete="off">
					<small class="text-muted d-block mt-1">Busca por nombre o categoría</small>

					<!-- Dropdown de resultados -->
					<div class="list-group position-absolute w-100 mt-1" id="accessorySuggestions"
						 style="display: none; z-index: 1000; max-height: 300px; overflow-y: auto;">
					</div>
				</div>
			</div>
			<div class="col-md-4 d-flex align-items-center">
				<button type="button" class="btn btn-primary w-100" id="addAccessoryBtn" disabled>
					<i class="fas fa-plus"></i> Agregar Accesorio
				</button>
			</div>
		</div>

		<!-- Tabla de accesorios seleccionados -->
		<div class="row g-3">
			<div class="col-md-12">
				<h6 class="text-muted text-uppercase small mb-3">Accesorios Agregados</h6>

				<div class="table-responsive">
					<table class="table table-hover" id="accessoriesTable">
						<thead class="table-light">
							<tr>
								<th style="width: 50%">Accesorio</th>
								<th class="text-end" style="width: 25%">Precio Unit.</th>
								<th class="text-center" style="width: 15%">Cantidad</th>
								<th class="text-end" style="width: 10%">Acción</th>
							</tr>
						</thead>
						<tbody id="accessoriesTableBody">
							<!-- Se llenarán dinámicamente los accesorios -->
						</tbody>
					</table>
				</div>

				<!-- Resumen de precios -->
				<div class="row g-3 mt-3">
					<div class="col-md-12">
						<div class="card bg-light">
							<div class="card-body">
								<div class="row text-end">
									<div class="col-md-6">
										<p class="mb-0">Subtotal Accesorios:</p>
									</div>
									<div class="col-md-6">
										<p class="mb-0 fw-bold" id="subtotalAccessories">$0</p>
									</div>
								</div>
								<hr class="my-2">
								<div class="row text-end">
									<div class="col-md-6">
										<p class="mb-0 h5">Total Accesorios:</p>
									</div>
									<div class="col-md-6">
										<p class="mb-0 h5 text-primary fw-bold" id="totalAccessories">$0</p>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

