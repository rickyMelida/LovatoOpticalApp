<div class="modal fade" id="coastPriceModal" tabindex="-1" aria-labelledby="coastPriceModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-lg modal-fullscreen-sm-down modal-dialog-scrollable">
		<div class="modal-content">
			<div class="modal-header">
				<h1 class="modal-title fs-5" id="coastPriceModalLabel">
					<i class="bi bi-eye me-2"></i>Precios de Recubrimientos
				</h1>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">

				<div class="container">
					<div class="row">
						<div class="col-12">
							<div class="row g-3 my-3">
								<div class="col-12 col-md-6">
									<label for="prec_rec_blanco" class="form-label">Blanco</label>
									<input type="text" class="form-control input-guarani" id="prec_rec_blanco" step="1"
										   min="0">
								</div>
								<div class="col-12 col-md-6">
									<label for="prec_rec_antirreflex" class="form-label">Antirreflex</label>
									<input type="text" class="form-control input-guarani" id="prec_rec_antirreflex"
										   step="1" min="0">
								</div>
								<div class="col-12 col-md-6">
									<label for="prec_rec_fotocromatic" class="form-label">Fotocrómático</label>
									<input type="text" class="form-control input-guarani" id="prec_rec_fotocromatic"
										   step="1" min="0">
								</div>
								<div class="col-12 col-md-6">
									<label for="prec_rec_filtro" class="form-label">Filtro Luz Azul</label>
									<input type="text" class="form-control input-guarani" id="prec_rec_filtro" step="1"
										   min="0">
								</div>
							</div>
						</div>
						<div class="col-12">
							<div class="row g-3">
								<div class="col-12 col-md-6">
									<button type="submit" class="btn btn-primary w-100">
										<i class="bi bi-floppy"></i> Guardar
									</button>
								</div>
								<div class="col-12 col-md-6">
									<button type="button" class="btn btn-danger w-100">
										<i class="bi bi-arrow-counterclockwise"></i> Cancelar
									</button>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>