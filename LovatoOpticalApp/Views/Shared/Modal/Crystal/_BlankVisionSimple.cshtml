<div class="modal fade" id="blankVisionSimpleModal" tabindex="-1" aria-labelledby="blankVisionSimpleModalLabel"
	 aria-hidden="true">
	<div class="modal-dialog modal-lg modal-fullscreen-sm-down modal-dialog-scrollable">
		<div class="modal-content">
			<div class="modal-header">
				<h1 class="modal-title fs-5" id="blankVisionSimpleModalLabel">
					<i class="bi bi-eye me-2"></i>Precios de Cristales
				</h1>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">

				<div class="container mt-4">
					<form class="row g-3" onsubmit="guardarConfig(event)">
						<div class="col-12">
							<div class="row g-3">
								<div class="col-12 col-md-6">
									<label for="prec_blanco" class="form-label">Blanco (Sin Graduación)</label>
									<input type="text" class="form-control input-guarani" id="prec_blanco" step="1"
										   min="0">
								</div>
								<div class="col-12 col-md-6">
									<label for="prec_simple" class="form-label">Visión Simple</label>
									<input type="text" class="form-control input-guarani" id="prec_simple" step="1"
										   min="0">
								</div>
							</div>
						</div>
						<div class="col-12">
							<div class="row g-3">
								<div class="col-12 col-md-6">
									<button type="submit" class="btn btn-primary w-100">
										<i class="bi bi-floppy"></i> Guardar
									</button>
								</div>
								<div class="col-12 col-md-6">
									<button type="button" class="btn btn-danger w-100">
										<i class="bi bi-arrow-counterclockwise"></i> Cancelar
									</button>
								</div>
							</div>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>
