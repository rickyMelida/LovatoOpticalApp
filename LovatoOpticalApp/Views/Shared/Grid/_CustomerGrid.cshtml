@using LovatoOpticalApp.Application.DTOs
@{
    var customers = ViewData["Customers"] as PagedResult<CustomerResponseDto> ?? new PagedResult<CustomerResponseDto>();
    int index = 1;
}

<div class="row">
    <div class="col-md-12">
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Nombre</th>
                        <th scope="col">RUC/CI</th>
                        <th scope="col">Correo</th>
                        <th scope="col">Dirección</th>
                        <th scope="col">Teléfono</th>
                        <th scope="col" class="text-center">Agregar Receta</th>
                        <th scope="col" class="text-center">Detalles</th>
                        <th scope="col" class="text-center">Editar</th>
                        <th scope="col" class="text-center">Eliminar</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in customers.Items)
                    {
                        var address = String.IsNullOrEmpty(customer.Address) ? "N/A" : customer.Address;

                        <tr>
                            <th scope="row">@index</th>
                            <td>@customer.Name</td>
                            <td>@customer.CiRuc</td>
                            <td>@customer.Email</td>
                            <td>@address</td>
                            <td>@customer.Phone</td>
                            <td class="text-center">
                                <a href="#" class="add-recipe" id="@customer.Id"><i class="bi bi-plus-circle text-primary w-100"></i></a>
                            </td>
                            <td class="text-center">
                                <a href="#" class="view-customer-details" data-bs-toggle="modal" data-bs-target="#viewCustomerModal" id="@customer.Id">
                                    <i class="bi bi-eye text-primary"></i>
                                </a>
                            </td>
                            <td class="text-center">
                                <a href="#" class="edit-customer" data-bs-toggle="modal" data-bs-target="#newCustomerModal" id="@customer.Id">
                                    <i class="bi bi-pencil text-warning"></i>
                                </a>
                            </td>
                            <td class="text-center delete-customer">
                                <a href="#" class="delete-customer" id="@customer.Id"><i class="bi bi-trash text-danger"></i></a>
                            </td>
                        </tr>
                        index++;
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (customers.Items.Count > 10)
    {
        <div class="col-md-12">
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(customers.HasPreviousPage ? string.Empty : "disabled")">
                        <a class="page-link" href="@Url.Action("Index", "Customer", new { pageNumber = customers.PageNumber - 1, pageSize = customers.PageSize })">Anterior</a>
                    </li>

                    @for (var pageNumber = 1; pageNumber <= customers.TotalPages; pageNumber++)
                    {
                        <li class="page-item @(pageNumber == customers.PageNumber ? "active" : string.Empty)">
                            <a class="page-link" href="@Url.Action("Index", "Customer", new { pageNumber = pageNumber, pageSize = customers.PageSize })">@pageNumber</a>
                        </li>
                    }

                    <li class="page-item @(customers.HasNextPage ? string.Empty : "disabled")">
                        <a class="page-link" href="@Url.Action("Index", "Customer", new { pageNumber = customers.PageNumber + 1, pageSize = customers.PageSize })">Siguiente</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>