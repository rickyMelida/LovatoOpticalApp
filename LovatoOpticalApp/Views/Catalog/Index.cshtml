@using LovatoOpticalApp.Application.DTOs;
@using LovatoOpticalApp.Application.DTOs.Common

@model PagedResult<ProductResponse>

@{
	ViewData["Title"] = "Catalog";
	var products = ViewData["Products"] as PagedResult<ProductResponse>
		?? new PagedResult<ProductResponse>();
}
<div class="row">
	<div class="col-md-12">
		<nav aria-label="breadcrumb">
			<ol class="breadcrumb">
				<li class="breadcrumb-item active" aria-current="page">Catalogos Productos</li>
			</ol>
		</nav>
	</div>
</div>

<div class="row mt-3 mb-2">
	<div class="col-12 col-md-6">
		<div class="row g-3 align-items-center">
			<div class="col-auto">
				<label for="inputPassword6" class="col-form-label">Buscar Producto</label>
			</div>
			<div class="col-auto">
				<input type="text" id="inputCatalogSearch" class="form-control" >
			</div>
		</div>
	</div>
	<div class="col-12 col-md-6 mt-2 mt-md-0">
		<button type="button" class="btn btn-primary float-md-end w-25" data-bs-toggle="modal"
				data-bs-target="#newProductModal">
			<i class="bi bi-plus-circle me-2"></i>Agregar
		</button>
	</div>
</div>

<div class="row">
	<div class="col-md-12">
		<hr />
	</div>
</div>

<div class="row mt-3 mb-2">
	<h6>Cantidad de Productos <span class="badge text-bg-primary">@products.Items.Count</span></h6>
</div>

<div id="catalogGridContainer">

	@if (products.Items.Count == 0)
	{
		<div class="row">
			<div class="col-md-12">
				<div class="alert alert-ligth text-center" role="alert">
					No se encontraron productos.
				</div>
			</div>
		</div>
	}
	else
	{
		@await Html.PartialAsync("Grid/_CatalogGrid")
	}
</div>

@*New Products Modal*@
@await Html.PartialAsync("Modal/Catalog/_NewProduct")
@await Html.PartialAsync("Modal/Catalog/Forms/_NewAccessory")
@await Html.PartialAsync("Modal/Catalog/Forms/_NewCrystal")
@await Html.PartialAsync("Modal/Catalog/Forms/_NewFrame")

@*Products Details Modal*@
@await Html.PartialAsync("Modal/Catalog/Details/_FrameDetail")

<script src="~/js/Catalog/Catalog.js" type="module"></script>