@{
    ViewData["Title"] = "Catalog";
}
<div class="row my-3">
    <div class="col-md-4 text-center">
        <button type="button" class="btn btn-ligth border border-3">
            Armazones <span class="badge text-bg-primary">40</span>
        </button>
    </div>
    <div class="col-md-4 text-center">
        <button type="button" class="btn btn-ligth border border-3">
            Cristales <span class="badge text-bg-primary">4</span>
        </button>
    </div>
    <div class="col-md-4 text-center">
        <button type="button" class="btn btn-ligth border border-3">
            Accesorios <span class="badge text-bg-primary">4</span>
