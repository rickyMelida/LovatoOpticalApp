@using LovatoOpticalApp.Application.DTOs
@using LovatoOpticalApp.Application.DTOs.Common
@using LovatoOpticalApp.Core.Entities.Enums
@{
    ViewData["Title"] = "Inventory";
    var products = ViewData["Products"] as PagedResult<ProductResponse>
        ?? new PagedResult<ProductResponse>();

    int numberOfFramesAvailable = products.Items.Where(e => e.Type == ProductTypeEnum.Frame).Sum(p => p.Quantity);
    int numberOfCrystalsAvailable = products.Items.Where(e => e.Type == ProductTypeEnum.Crystal).Sum(p => p.Quantity);
    int numberOfAccessoriesAvailable = products.Items.Where(e => e.Type == ProductTypeEnum.Accessory).Sum(p => p.Quantity);

}
<div class="row my-3">
    <div class="col-md-4 text-center">
        <button type="button" class="btn btn-ligth border border-3">
            Armazones <span class="badge text-bg-primary">@numberOfFramesAvailable</span>
        </button>
    </div>
    <div class="col-md-4 text-center">
        <button type="button" class="btn btn-ligth border border-3">
            Cristales <span class="badge text-bg-primary">@numberOfCrystalsAvailable</span>
        </button>
    </div>
    <div class="col-md-4 text-center">
        <button type="button" class="btn btn-ligth border border-3">
            Accesorios <span class="badge text-bg-primary">@numberOfAccessoriesAvailable</span>
        </button>
    </div>
</div>
<div class="row">
    <div class="col-md-1"></div>
    <div class="col-md-10">
        <hr class="mx-auto" />
    </div>
</div>
<div class="row mt-5 mb-2">
    <div class="col-md-6">

        <div class="row g-3 align-items-center">
            <div class="col-auto">
                <label for="inputPassword6" class="col-form-label">Buscar Producto</label>
            </div>
            <div class="col-auto">
                <input type="password" id="inputPassword6" class="form-control" aria-describedby="passwordHelpInline">
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <hr />
    </div>
</div>



<div class="row mt-3 mb-2">
    <h6>Cantidad de Productos <span class="badge text-bg-primary">@products.Items.Count</span></h6>
</div>

@if (products.Items.Count == 0)
{
    <div class="row">
        <div class="col-md-12">
            <div class="alert alert-ligth text-center" role="alert">
                No se encontraron productos.
            </div>
        </div>
    </div>
}
else
{
    @await Html.PartialAsync("Grid/_InventoryGrid")
}

@await Html.PartialAsync("Modal/Inventory/_AddInventory")

<script src="~/js/Inventory/Inventory.js" type="module"></script>