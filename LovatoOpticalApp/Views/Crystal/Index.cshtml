@{
    ViewData["Title"] = "Pedido";
}
<div class="row">
    <div class="col-md-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item active" aria-current="page">Precios de Cristales</li>
            </ol>
        </nav>
    </div>
</div>
<div class="row mt-3 mb-2">
    <div class="col-12 col-md-6">

        <div class="row g-3 align-items-center">
            <div class="col-auto">
                <label for="inputPassword6" class="col-form-label">Buscar Pedido</label>
            </div>
            <div class="col-auto">
                <input type="password" id="inputPassword6" class="form-control" aria-describedby="passwordHelpInline">
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 mt-2 mt-md-0">
            <a class="btn btn-primary float-md-end w-25" id="btnLoadCrystalPrices" >
                <i class="bi bi-plus-circle me-2"></i>Cargar Precios
            </a>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Tipo</th>
                        <th scope="col">Nombre</th>
                        <th scope="col">Precio</th>
                        <th scope="col">Ultima Modificación</th>
                    </tr>
                </thead>
                <tbody>
					<tr>
                        <th scope="row">1</th>
                        <td>Cristal</td>
                        <td>Blanco</td>
                        <td>Gs. 10.000</td>
						<td>12/01/2023</td>
                    </tr>
					<tr>
                        <th scope="row">2</th>
                        <td>Cristal</td>
                        <td>Vision Simple</td>
                        <td>Gs. 15.000</td>
						<td>12/01/2023</td>
                    </tr>
                    <tr>
                        <th scope="row">3</th>
                        <td>Cristal</td>
                        <td>Kryptop</td>
                        <td>Gs. 25.000</td>
						<td>12/01/2023</td>
                    </tr>
					<tr>
                        <th scope="row">4</th>
                        <td>Cristal</td>
                        <td>Flaptop</td>
                        <td>Gs. 35.000</td>
						<td>12/01/2023</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-md-12">
        <nav aria-label="Page navigation example">
            <ul class="pagination justify-content-center">
                <li class="page-item"><a class="page-link" href="#">Previous</a></li>
                <li class="page-item"><a class="page-link" href="#">1</a></li>
                <li class="page-item"><a class="page-link" href="#">2</a></li>
                <li class="page-item"><a class="page-link" href="#">3</a></li>
                <li class="page-item"><a class="page-link" href="#">Next</a></li>
            </ul>
        </nav>
    </div>
</div>

@await Html.PartialAsync("Modal/Crystal/_TypeCrystal")
@await Html.PartialAsync("Modal/Crystal/_PricePerAddition")
@await Html.PartialAsync("Modal/Crystal/_CoatsPrices")
@await Html.PartialAsync("Modal/Crystal/_Multifocal")
@await Html.PartialAsync("Modal/Crystal/_Bifocal")
@await Html.PartialAsync("Modal/Crystal/_BlankVisionSimple")


<script src="~/js/Crystal/Crystal.js" type="module"></script>