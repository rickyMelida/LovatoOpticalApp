<div class="container mt-4">
	<h2>Precios de Cristales</h2>

	<form class="row g-3" onsubmit="guardarConfig(event)">
		<div class="col-12">
			<div class="row g-3">
				<div class="col-12 col-md-6">
					<label for="prec_blanco" class="form-label">Blanco (Sin Graduación)</label>
					<input type="text" class="form-control input-guarani" id="prec_blanco" step="1" min="0">
				</div>
				<div class="col-12 col-md-6">
					<label for="prec_simple" class="form-label">Visión Simple</label>
					<input type="text" class="form-control input-guarani" id="prec_simple" step="1" min="0">
				</div>
				<div class="col-12 col-md-6">
					<label for="prec_bifocal_kriptop" class="form-label">Bifocal Kriptop</label>
					<input type="text" class="form-control input-guarani" id="prec_bifocal_kriptop" step="1" min="0">
				</div>
				<div class="col-12 col-md-6">
					<label for="prec_bifocal_flaptop" class="form-label">Bifocal Flaptop</label>
					<input type="text" class="form-control input-guarani" id="prec_bifocal_flaptop" step="1" min="0">
				</div>
			</div>
		</div>

		<div class="col-12">
			<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
				<div>
					<h5 class="mb-1"><i class="fas fa-glasses"></i> Precios de Multifocales</h5>
					<p class="text-muted mb-0">Registra cada precio según la marca y la línea o gama del cristal.</p>
				</div>
				<button type="button" class="btn btn-outline-primary" id="agregar-multifocal">
					<i class="bi bi-plus-lg"></i> Agregar multifocal
				</button>
			</div>
			<div class="table-responsive mt-3">
				<table class="table align-middle">
					<thead>
						<tr>
							<th scope="col">Marca</th>
							<th scope="col">Descripción</th>
							<th scope="col">Precio</th>
							<th scope="col"><span class="visually-hidden">Acciones</span></th>
						</tr>
					</thead>
					<tbody id="multifocales-lista"></tbody>
				</table>
				<p class="text-muted mb-0" id="multifocales-vacio">Aún no se agregaron precios de multifocales.</p>
			</div>
		</div>

		<div class="col-12">
			<h5 class="mt-3"><i class="fas fa-layer-group"></i> Precios de Recubrimientos</h5>
			<div class="row g-3 my-3">
				<div class="col-12 col-md-6">
					<label for="prec_rec_blanco" class="form-label">Blanco</label>
					<input type="text" class="form-control input-guarani" id="prec_rec_blanco" step="1" min="0">
				</div>
				<div class="col-12 col-md-6">
					<label for="prec_rec_antirreflex" class="form-label">Antirreflex</label>
					<input type="text" class="form-control input-guarani" id="prec_rec_antirreflex" step="1" min="0">
				</div>
				<div class="col-12 col-md-6">
					<label for="prec_rec_fotocromatic" class="form-label">Fotocrómático</label>
					<input type="text" class="form-control input-guarani" id="prec_rec_fotocromatic" step="1" min="0">
				</div>
				<div class="col-12 col-md-6">
					<label for="prec_rec_filtro" class="form-label">Filtro Luz Azul</label>
					<input type="text" class="form-control input-guarani" id="prec_rec_filtro" step="1" min="0">
				</div>
			</div>
		</div>

		<div class="col-12">
			<h5><i class="fas fa-plus"></i> Precio de Adición</h5>
			<div class="row g-3">
				<div class="col-12 col-md-6 col-lg-4">
					<label for="prec_adicion" class="form-label">Precio Adición</label>
					<input type="text" class="form-control input-guarani" id="prec_adicion" step="1" min="0">
				</div>
			</div>
		</div>

		<div class="col-12">
			<div class="row g-3">
				<div class="col-12 col-md-6">
					<button type="submit" class="btn btn-primary w-100">
						<i class="bi bi-floppy"></i> Guardar
					</button>
				</div>
				<div class="col-12 col-md-6">
					<button type="button" class="btn btn-warning w-100">
						<i class="bi bi-arrow-counterclockwise"></i> Restaurar Defecto
					</button>
				</div>
			</div>
		</div>
	</form>
</div>

<template id="fila-multifocal-template">
	<tr>
		<td>
			<input type="text" class="form-control multifocal-marca" placeholder="Ej.: Marca"
				   aria-label="Marca del multifocal">
		</td>
		<td>
			<input type="text" class="form-control multifocal-description" placeholder="Ej.: Descripción de la línea o gama"
				   aria-label="Descripción del multifocal">
		</td>
		<td>
			<input type="text" class="form-control input-guarani multifocal-precio" inputmode="numeric"
				   placeholder="Precio en guaraníes" aria-label="Precio del multifocal">
		</td>
		<td class="text-end">
			<button type="button" class="btn btn-outline-danger quitar-multifocal" aria-label="Quitar multifocal">
				<i class="bi bi-trash"></i>
			</button>
		</td>
	</tr>
</template>

<script src="~/js/Crystal/Crystal.js" type="module"></script>
